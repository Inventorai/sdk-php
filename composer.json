{
    "name": "inventorai/sdk",
    "description": "Official PHP SDK for the Inventorai API",
    "type": "library",
    "keywords": ["inventorai", "api", "sdk", "property", "inspection"],
    "license": "MIT",
    "authors": [
        {
            "name": "Inventorai",
            "email": "support@inventorai.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Inventorai\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inventorai\\SDK\\Tests\\": "tests/"
        }
    },
    "version": "2.0.0",
    "minimum-stability": "stable",
    "prefer-stable": true
}
